# Activation caches and model weights — tens of GB, never commit
runs/*/activations/
runs/*/cache/
*.pt
*.safetensors
*.npy
*.npz

# Run scratch: everything under runs/ is ignored EXCEPT the two files
# that make a run reproducible and comparable.
runs/*/*
!runs/*/config.yaml
!runs/*/metrics.json

# Stage 1 failure dumps can get large; keep the summary, drop the raw dump
runs/*/alignment_failures.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Env
.env
